# Poneglyph Configuration
# Copy this file to .env and fill in the values

# Anthropic API key (required for LLM synthesis in later phases)
ANTHROPIC_API_KEY=sk-ant-...

# Database path (default: data/poneglyph.db)
DATABASE_PATH=data/poneglyph.db

# PDF storage directory (default: data/pdfs)
PDF_DIR=data/pdfs

# Server settings
HOST=127.0.0.1
PORT=8000
