# Poneglyph Configuration
# Copy this file to .env and fill in the values. Never commit your real .env.

# --- Required ---
# Anthropic API key — powers structural skim, deep synthesis, and Q&A
ANTHROPIC_API_KEY=sk-ant-...

# --- Recommended ---
# Semantic Scholar API key — much higher citation-graph rate limits.
# Without it, the shared unauthenticated pool is heavily throttled (frequent 429s).
# Request one free: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# --- Storage (optional; sensible defaults in poneglyph/config.py) ---
# SQLite database path
DATABASE_PATH=data/poneglyph.db

# PDF storage directory
PDF_DIR=data/pdfs

# Override these if your PDF / ebook libraries live elsewhere
# (defaults point at the original author's OneDrive layout)
# PDF_BASE_DIR=
# EBOOK_LIBRARY_DIR=

# --- Server (optional) ---
HOST=127.0.0.1
PORT=8000

# --- Off-site backup (optional; used by scripts/backup_db.py) ---
# Fine-grained GitHub PAT with Contents:read/write on the backup repo only.
# Leave empty to skip the GitHub push and back up locally only.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=https://github.com/<your-username>/poneglyph_backup.git
